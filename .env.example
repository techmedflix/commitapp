# Frontend (Vite) — also set these on Vercel
VITE_GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
VITE_API_BASE_URL="/api"

# Backend — set on Vercel as server env (NOT VITE_*)
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
DATABASE_URL="postgres://user:password@host:5432/commitapp"
# RDS typically requires SSL — use 1 for AWS; 0 only if server allows non-SSL
DATABASE_SSL=1
JWT_SECRET="change-me"
PORT=3001
